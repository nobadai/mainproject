# 로컬 Compose 기본값
APP_VERSION=dev
FRONTEND_PORT=80
BACKEND_PORT=8000
BACKEND_IMAGE=mainproject-backend:local
FRONTEND_IMAGE=mainproject-frontend:local

# Docker Compose database connection (required for `docker compose up`).
# DB_HOST=
# DB_PORT=5432
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# DB_SCHEMA=

# ─── LLM (매입 에이전트 ⑤ 등급 조합 판단 · Epic 3 E3-2) ───────────────────
# 아무것도 설정하지 않아도 동작한다. 키·서버가 없으면 규칙 기본안으로 자동 fallback하고,
# 그 사실이 제안의 risks에 고지된다 — 브랜치만 받아도 산출물이 그대로 나온다.
#
# PURCHASE_ 접두사를 붙이면 매입 에이전트에만 적용된다 (다른 에이전트와 분리).
# 접두사 없는 이름은 팀 공통 규약이고, 접두사가 우선한다.
#
# LLM_PROVIDER=anthropic     # anthropic | openai | ollama
# LLM_ENABLED=true           # false면 호출 없이 규칙 경로
# LLM_MODEL=claude-haiku-4-5-20251001   # anthropic 기본값. openai는 기본이 없어 반드시 지정
#   ⑤가 맡기는 일은 "후보 3개 중 선택 + 사유 한 문장"이라 최저 티어로 충분하다.
#   백테스트는 회당 품목 수만큼 호출하므로 상위 모델은 비용·지연만 곱한다.
#   별칭(claude-haiku-4-5)이 아니라 날짜 붙은 스냅샷을 쓴다 — 같은 as_of가 같은 결과를
#   내야 백테스트 성적이 성립한다.
# LLM_EFFORT=low             # anthropic 전용. **기본은 미설정이다**
#   ⚠️ 모델마다 지원 여부가 다르다. 기본 모델인 Haiku 4.5는 effort를 지원하지 않아
#   값을 넣으면 호출이 매번 실패하고 조용히 규칙 기본안으로 떨어진다.
#   상위 모델(claude-opus-5 등)로 올릴 때만 함께 켠다.
# LLM_TIMEOUT_SECONDS=30
# LLM_MAX_RETRIES=1
# LLM_MAX_OUTPUT_TOKENS=8192
# LLM_BASE_URL=http://127.0.0.1:11434   # ollama 전용
#
# API 키는 .env에만 둔다 (.env는 gitignore 대상). 코드에 기본값이 없다.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# ─── Docker Compose / local runtime provider profile ──────────────────────
# `Copy-Item .env.example .env` 후 아래 **모든** 이름에 로컬 값을 적습니다. `.env`는
# gitignore 대상이며, `docker compose up`은 누락된 값을 거부하고 같은 이름을 backend container로 넘깁니다.
# 직접 backend를 실행하는 개발 환경은 `backend/.env`에도 같은 값을 둘 수 있습니다.
# 운영 배포는 이 모든 이름을 GitHub Actions Secrets에서 받습니다.
#
# LLM_ENABLED=
# LLM_PROVIDER=
# LLM_MODEL=
# LLM_BASE_URL=             # Windows host Ollama면 http://host.docker.internal:11434
# LLM_TIMEOUT_SECONDS=
# LLM_MAX_RETRIES=
# LLM_MAX_OUTPUT_TOKENS=
# LLM_EFFORT=
# MASTER_LLM_ENABLED=
# MASTER_LLM_PROVIDER=
# MASTER_LLM_MODEL=
# MASTER_LLM_BASE_URL=
# CRITIC_LLM_ENABLED=
# CRITIC_LLM_PROVIDER=
# CRITIC_LLM_MODEL=
# CRITIC_LLM_BASE_URL=
# FINANCE_LLM_ENABLED=
# FINANCE_LLM_PROVIDER=
# FINANCE_LLM_MODEL=
# FINANCE_LLM_BASE_URL=
# FINANCE_OLLAMA_PLANNER_MODEL=
# SALES_LLM_ENABLED=
# SALES_LLM_PROVIDER=
# SALES_LLM_MODEL=
# LOGISTICS_LLM_ENABLED=
# LOGISTICS_LLM_PROVIDER=
# LOGISTICS_LLM_MODEL=
# LOGISTICS_LLM_BASE_URL=
# LOGISTICS_MASTER_LLM_ENABLED=
# PURCHASE_LLM_ENABLED=
# PURCHASE_LLM_PROVIDER=
# PURCHASE_LLM_MODEL=
# PURCHASE_LLM_BASE_URL=
# ML_LLM_ENABLED=
# ML_LLM_MODEL=
# ML_CONSOLE_ORIGIN=        # Windows host ML이면 http://host.docker.internal:8102
# GEMINI_BASE_URL=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# MASTER_GEMINI_API_KEY=
# CRITIC_GEMINI_API_KEY=
# FINANCE_GEMINI_API_KEY=
# SALES_GEMINI_API_KEY=
# LOGISTICS_GEMINI_API_KEY=
# ML_GEMINI_API_KEY=
