# 로컬 Compose 기본값
APP_VERSION=dev
FRONTEND_PORT=80
BACKEND_PORT=8000
BACKEND_IMAGE=mainproject-backend:local
FRONTEND_IMAGE=mainproject-frontend:local

# Docker Compose database connection (required for `docker compose up`).
# DB_HOST=
# DB_PORT=5432
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# DB_SCHEMA=

# ─── LLM (매입 에이전트 ⑤ 등급 조합 판단 · Epic 3 E3-2) ───────────────────
# 아무것도 설정하지 않아도 동작한다. 키·서버가 없으면 규칙 기본안으로 자동 fallback하고,
# 그 사실이 제안의 risks에 고지된다 — 브랜치만 받아도 산출물이 그대로 나온다.
#
# PURCHASE_ 접두사를 붙이면 매입 에이전트에만 적용된다 (다른 에이전트와 분리).
# 접두사 없는 이름은 팀 공통 규약이고, 접두사가 우선한다.
#
# LLM_PROVIDER=anthropic     # anthropic | openai | ollama | gemini
# LLM_ENABLED=true           # false면 호출 없이 규칙 경로
# LLM_MODEL=claude-haiku-4-5-20251001   # anthropic 기본값. openai는 기본이 없어 반드시 지정
#   ⑤가 맡기는 일은 "후보 3개 중 선택 + 사유 한 문장"이라 최저 티어로 충분하다.
#   백테스트는 회당 품목 수만큼 호출하므로 상위 모델은 비용·지연만 곱한다.
#   별칭(claude-haiku-4-5)이 아니라 날짜 붙은 스냅샷을 쓴다 — 같은 as_of가 같은 결과를
#   내야 백테스트 성적이 성립한다.
# LLM_EFFORT=low             # anthropic 전용. **기본은 미설정이다**
#   ⚠️ 모델마다 지원 여부가 다르다. 기본 모델인 Haiku 4.5는 effort를 지원하지 않아
#   값을 넣으면 호출이 매번 실패하고 조용히 규칙 기본안으로 떨어진다.
#   상위 모델(claude-opus-5 등)로 올릴 때만 함께 켠다.
# LLM_TIMEOUT_SECONDS=30
# LLM_MAX_RETRIES=1
# LLM_MAX_OUTPUT_TOKENS=8192
# LLM_BASE_URL=http://127.0.0.1:11434   # ollama 전용
#
# API 키는 .env에만 둔다 (.env는 gitignore 대상). 코드에 기본값이 없다.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
#
# ── gemini (2026-09-15 추가) ─────────────────────────────────────────────
# 팀의 다른 다섯(마스터·critic·판매·재무·물류)이 쓰는 provider다. 매입만 표에 이름이
# 없어서, .env에 GEMINI_API_KEY가 있어도 매입은 그 키를 못 썼다.
#
# PURCHASE_GEMINI_API_KEY=       # 전용 키. 없으면 아래 공용 키로 떨어진다
# GEMINI_API_KEY=                # 팀 공용 — 마스터·판매·재무가 같이 쓴다
#   🔴 전용 키를 안 넣고 provider만 gemini로 바꾸면 호출이 조용히 성공하면서
#      팀 공용 한도를 같이 깎는다. 전용 키를 넣는 것이 기본이다.
#   ⚠️ 키가 둘 다 없어도 죽지 않는다 — 규칙 기본안으로 떨어지고 그 사실이 흔적에 남는다.
#
# LLM_MODEL=gemini-3.5-flash-lite   # gemini 기본값. 마스터·재무·물류가 pin한 것과 같다
#   파트마다 다른 모델을 쓰면 "모델이 달라서 그런가"가 모든 조사에 끼어든다.
#   🔴 **provider만 바꾸면 모델 이름은 안 따라온다.** provider별 기본값은 LLM_MODEL이
#      비어 있을 때만 쓰인다 — .env에 LLM_MODEL=gemma3:4b가 있는 채로 provider를
#      gemini로 바꾸면 Gemini에게 ollama 모델 이름을 보내고 404를 받는다.
#      ⇒ provider를 바꿀 때는 **모델도 같이 바꾼다.**
# PURCHASE_GEMINI_BASE_URL=      # 보통 비워 둔다
#   🔴 LLM_BASE_URL을 쓰지 않는다. 그 기본값이 ollama(127.0.0.1:11434)라,
#      provider만 gemini로 바꾸면 로컬 포트로 쏘고 "연결 실패"로만 보인다.

# ─── 매입 에이전트 기능 플래그 — 셋 다 **기본 꺼짐** (Epic 3 · E3-9·E3-10·E3-11) ──
# 켜면 산출물의 모양이 바뀐다. 정본 걷기와 대조할 기준이 사라지므로, 켜는 것은
# 조건이 풀린 뒤의 별도 판단이다. 아무것도 안 적으면 전부 꺼진 상태다.
#
# PURCHASE_LLM_SPLIT_ALLOCATION_ENABLED=false   # ④ 회차별 배분 판단자
#   켜도 지금은 효과가 0이다 — 비율 선언이 PROVISIONAL이고, 승인해도
#   inbound_lead_days가 미결이라 사전검사가 가중치 후보를 전부 걷어낸다.
# PURCHASE_LLM_SELF_REVIEW_ENABLED=false        # ⑧ 근거 자기 검토
#   켜면 안의 risks에 경고가 붙는다. 수량·금액·등급·날짜·컷 결과는 안 바뀐다.
# PURCHASE_INFORMATION_REQUESTS_ENABLED=false   # 부족 정보 요청 (LLM 아님)
#   🔴 끄는 것은 **구조화 출력 한 칸뿐**이다. 「못 판정했다」는 판정도 사람이 읽는
#      고지(risks)도 이 값과 무관하게 그대로 나간다.

# ─── Docker Compose / local runtime provider profile ──────────────────────
# `Copy-Item .env.example .env` 후 아래 **모든** 이름에 로컬 값을 적습니다. `.env`는
# gitignore 대상이며, `docker compose up`은 누락된 값을 거부하고 같은 이름을 backend container로 넘깁니다.
# 직접 backend를 실행하는 개발 환경은 `backend/.env`에도 같은 값을 둘 수 있습니다.
# 운영 배포는 이 모든 이름을 GitHub Actions Secrets에서 받습니다.
#
# LLM_ENABLED=
# LLM_PROVIDER=
# LLM_MODEL=
# LLM_BASE_URL=             # Windows host Ollama면 http://host.docker.internal:11434
# LLM_TIMEOUT_SECONDS=
# LLM_MAX_RETRIES=
# LLM_MAX_OUTPUT_TOKENS=
# LLM_EFFORT=
# MASTER_LLM_ENABLED=
# MASTER_LLM_PROVIDER=
# MASTER_LLM_MODEL=
# MASTER_LLM_BASE_URL=
# CRITIC_LLM_ENABLED=
# CRITIC_LLM_PROVIDER=
# CRITIC_LLM_MODEL=
# CRITIC_LLM_BASE_URL=
# FINANCE_LLM_ENABLED=
# FINANCE_LLM_PROVIDER=
# FINANCE_LLM_MODEL=
# FINANCE_LLM_BASE_URL=
# FINANCE_OLLAMA_PLANNER_MODEL=
# SALES_LLM_ENABLED=
# SALES_LLM_PROVIDER=
# SALES_LLM_MODEL=
# LOGISTICS_LLM_ENABLED=
# LOGISTICS_LLM_PROVIDER=
# LOGISTICS_LLM_MODEL=
# LOGISTICS_LLM_BASE_URL=
# LOGISTICS_MASTER_LLM_ENABLED=
# PURCHASE_LLM_ENABLED=
# PURCHASE_LLM_PROVIDER=
# PURCHASE_LLM_MODEL=
# PURCHASE_LLM_BASE_URL=
# ML_LLM_ENABLED=
# ML_LLM_MODEL=
# ML_CONSOLE_ORIGIN=        # Windows host ML이면 http://host.docker.internal:8102
# GEMINI_BASE_URL=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# MASTER_GEMINI_API_KEY=
# CRITIC_GEMINI_API_KEY=
# FINANCE_GEMINI_API_KEY=
# SALES_GEMINI_API_KEY=
# LOGISTICS_GEMINI_API_KEY=
# ML_GEMINI_API_KEY=
