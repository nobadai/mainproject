# ============================================================
# Database
# ============================================================

DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SCHEMA=

ML_SOURCE_DB_HOST=
ML_SOURCE_DB_PORT=
ML_SOURCE_DB_NAME=
ML_SOURCE_DB_USER=
ML_SOURCE_DB_PASSWORD=

# ============================================================
# Common LLM
# ============================================================
# Agent별 설정이 없을 때 사용하는 공통 LLM 설정입니다.
# 실제 API Key는 반드시 .env에서만 관리합니다.

LLM_ENABLED=true
LLM_PROVIDER=ollama
LLM_MODEL=gemma3:4b
LLM_BASE_URL=http://127.0.0.1:11434
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1


# ============================================================
# Master / Orchestrator / Critic
# ============================================================

CRITIC_LLM_PROVIDER=gemini
# CRITIC_LLM_MODEL=qwen2.5:7b     ← 주석 처리하거나 지우세요 (그러면 기본값 적용)
GEMINI_API_KEY=              ← Critic 은 MASTER_ 접두어를 안 봅니다
CRITIC_LLM_TIMEOUT_SECONDS=90  

# Master Agent
MASTER_LLM_PROVIDER=gemini
MASTER_LLM_MODEL=gemini-3.6-flash
MASTER_GEMINI_API_KEY=


# ============================================================
# Finance Agent LLM
# ============================================================
# Finance Agent는 현재 Gemini를 기본 Provider로 사용합니다.
#
# 지원 Provider:
# - gemini
# - ollama
#
# Primary:
# - Gemini gemini-3.5-flash-lite
#
# Availability fallback:
# - Ollama gemma3:4b
#
# 실제 API Key는 .env에만 설정하고 Git에 커밋하지 않습니다.

FINANCE_LLM_ENABLED=true
FINANCE_LLM_PROVIDER=gemini
FINANCE_LLM_MODEL=gemini-3.5-flash-lite

# Finance 전용 Gemini API Key
# 비어 있으면 코드에서 공통 GEMINI_API_KEY를 사용할 수 있습니다.
FINANCE_GEMINI_API_KEY=

# Finance Tool-calling Planner availability fallback
FINANCE_OLLAMA_PLANNER_MODEL=llama3.2:3b


# ============================================================
# Sales Agent LLM
# ============================================================
# Sales Agent의 Scenario 후보를 비교·해석하고
# 사용자에게 추천 이유를 설명하는 LLM 설정입니다.
#
# LLM은 판매 가격·수량·납기·결제조건 등의 숫자를 생성하지 않습니다.
# 실제 Scenario는 Sales의 deterministic Rule/Tool이 생성합니다.
#
# Sales Agent의 LLM 기반 후보 해석/추천 기능 사용 여부입니다.
# false면 외부 호출 없이 규칙 기반 추천을 사용합니다.
SALES_LLM_ENABLED=true

# 현재 Sales Runtime은 gemini만 지원합니다.
# 지원하지 않는 Provider는 FALLBACK 처리됩니다.
SALES_LLM_PROVIDER=gemini

# Sales에서 사용할 Gemini 모델명입니다.
SALES_LLM_MODEL=gemini-3.5-flash-lite

# Sales 전용 Gemini API Key입니다.
# 비워두면 GEMINI_API_KEY를 fallback으로 사용합니다.
# 실제 값은 .env에만 작성합니다.
SALES_GEMINI_API_KEY=


# ============================================================
# Logistics Agent LLM
# ============================================================
# Logistics만 Gemini로 전환할 때 사용하는 설정입니다.
#
# 전역 LLM_PROVIDER를 gemini로 변경하면 다른 Agent에도 영향을 주므로
# Logistics 전용 override를 사용합니다.
#
# 모델은 stable 버전을 고정해서 사용합니다.
# latest / preview 별칭 사용은 피합니다.
#
# 실제 API Key는 .env에만 설정합니다.

# LOGISTICS_LLM_ENABLED=true
# LOGISTICS_LLM_PROVIDER=gemini
# LOGISTICS_LLM_MODEL=gemini-3.5-flash-lite
# LOGISTICS_LLM_TIMEOUT_SECONDS=10
# LOGISTICS_GEMINI_API_KEY=
#
# Master 경로(SCENARIO_VALIDATION 회신)의 해석 LLM 은 **별도 opt-in** 입니다 (#385).
# 위 설정만으로는 마스터 동기 경로에서 외부 Provider 가 불리지 않습니다 —
# 값이 없으면 꺼짐이고, 켜려면 아래를 true 로 두어야 합니다 (LOGISTICS_LLM_ENABLED 와 AND).
# LOGISTICS_MASTER_LLM_ENABLED=false


# ============================================================
# Optional Agent Overrides
# ============================================================
# Agent별 설정이 존재하면 공통 LLM_* 설정보다 우선합니다.
#
# 사용 가능한 prefix 예:
#
# ORCHESTRATOR_
# CRITIC_
# LOGISTICS_
# FINANCE_
# SALES_
#
# 적용 가능한 설정 예:
#
# <AGENT>_LLM_ENABLED
# <AGENT>_LLM_PROVIDER
# <AGENT>_LLM_MODEL
# <AGENT>_LLM_BASE_URL
# <AGENT>_LLM_TIMEOUT_SECONDS
# <AGENT>_LLM_MAX_RETRIES


# ============================================================
# Security
# ============================================================
# 실제 API Key / Password / 개인 환경값은 이 파일에 작성하지 않습니다.
#
# 금지:
# - 실제 API Key 커밋
# - .env 내용 복사
# - 로그에 API Key 출력
#
# 실제 값은 로컬 .env에서만 관리합니다.

# ML 콘솔 백엔드 주소 (ML 파트가 띄우는 서버)
#   같은 컴퓨터에서 돌릴 때만 127.0.0.1 을 씁니다.
#   다른 컴퓨터에서 열려면 ML 서버의 랜 주소를 적으세요 (예: http://192.168.0.x:8102)
ML_CONSOLE_ORIGIN=http://127.0.0.1:8102
ML_GEMINI_API_KEY=


# ============================================================
# Purchase Agent LLM
# ============================================================
# 매입 에이전트의 LLM 설정입니다. PURCHASE_ 접두어가 공통 설정보다 우선합니다.
# 아무것도 설정하지 않아도 동작합니다 — 키·서버가 없으면 규칙 기본안으로 떨어지고
# 그 사실이 제안의 risks 와 실행 흔적(llm_calls)에 남습니다.
#
# 지원 Provider: anthropic | openai | ollama | gemini

# PURCHASE_LLM_PROVIDER=ollama
# PURCHASE_LLM_ENABLED=true
# PURCHASE_LLM_MODEL=gemini-3.5-flash-lite
#   🔴 provider 를 바꿀 때는 **모델도 같이 바꿉니다.** provider 별 기본 모델은
#      LLM_MODEL 이 비어 있을 때만 쓰이므로, LLM_MODEL=gemma3:4b 가 남은 채
#      provider 만 gemini 로 바꾸면 Gemini 에 ollama 모델 이름을 보내고 404 를 받습니다.

# 매입 전용 Gemini API Key (2026-09-15 추가)
# 비어 있으면 공용 GEMINI_API_KEY 로 떨어집니다.
#   🔴 그러면 마스터·판매·재무가 쓰는 **같은 한도**를 같이 깎습니다.
#      전용 키를 넣는 것이 기본이고, 공용 폴백은 "브랜치만 받아도 돈다"를 위한 것입니다.
PURCHASE_GEMINI_API_KEY=

# 보통 비워 둡니다.
#   🔴 LLM_BASE_URL 을 쓰지 않습니다 — 그 기본값이 ollama(127.0.0.1:11434)라,
#      provider 만 gemini 로 바꾸면 로컬 포트로 쏘고 "연결 실패"로만 보입니다.
# PURCHASE_GEMINI_BASE_URL=

# ── 기능 플래그 — 셋 다 기본 꺼짐 (E3-9 · E3-10 · E3-11) ──────────────────
# 각 기능은 **서로 독립적으로** 설정합니다. 한 줄을 켜도 다른 기능은 따라 켜지지 않고,
# 아무것도 안 적으면 셋 다 꺼진 상태입니다.
# 켜면 산출물이 달라질 수 있고, LLM 기능(E3-9 · E3-10)은 호출 비용과 응답 시간도 늘 수 있습니다.
#   🔴 켜기 전후를 비교할 때는 **코드 기준(커밋) · 입력 · 플래그 조건**을 함께 기록합니다.
#      셋 중 하나라도 빠지면 차이가 어느 쪽에서 왔는지 가를 수 없습니다.
#   ⚠️ PURCHASE_LLM_ENABLED=false 면 E3-9 · E3-10 도 LLM 을 부르지 않습니다.
#
# PURCHASE_LLM_SPLIT_ALLOCATION_ENABLED=false   # E3-9 ④ 회차별 배분 판단자
#   배분 후보(비율 판 0.1)는 승인 반영이 끝났습니다 (#794). 실제로 쓰려면 이 줄을 따로 켜야 합니다.
#   켜도 매번 부르지 않습니다 — 분할(다회차)에 들어갔고, 결과에 그대로 적용될 안전한 배분
#   후보가 둘 이상(균등 포함) 남은 날에만 판단자를 부릅니다.
# PURCHASE_LLM_SELF_REVIEW_ENABLED=false        # E3-10 ⑧ 근거 자기 검토
#   살아남은 안의 근거를 한 번 더 읽고 risks 에 경고를 더합니다.
#   구매안을 고치거나 탈락시키는 권한은 없습니다.
# PURCHASE_INFORMATION_REQUESTS_ENABLED=false   # E3-11 부족 정보 요청 (LLM 아님)
#   부족한 정보를 구조화된 요청으로 출력합니다. 끄더라도 「못 판정했다」는 판정과
#   사람이 읽는 고지는 그대로 나갑니다.
#   🔴 마스터의 자동 재수집 · 재실행을 켜는 기능이 아닙니다.
