DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SCHEMA=
# 공통 LLM 설정 (에이전트별 override 가 없으면 이 값을 쓴다)
LLM_ENABLED=true
LLM_PROVIDER=ollama
LLM_MODEL=gemma3:4b
LLM_BASE_URL=http://127.0.0.1:11434
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
ORCHESTRATOR_LLM_MODEL=qwen2.5:7b   # 오케 selector 만
CRITIC_LLM_MODEL=exaone3.5:7.8b     # Critic judge 만
MASTER_LLM_PROVIDER=gemini
MASTER_GEMINI_API_KEY=

# Finance Agent LLM
# ollama | gemini
FINANCE_LLM_PROVIDER=ollama

# Ollama default: gemma3:4b
# Gemini tested candidate: gemini-3.5-flash-lite
FINANCE_LLM_MODEL=gemma3:4b

# Finance-specific Gemini API key.
# Falls back to GEMINI_API_KEY when empty.
# Never commit a real key.
FINANCE_GEMINI_API_KEY=

# 에이전트별 override (선택) — 두면 위 공통값을 덮는다.
# 지원: ORCHESTRATOR_ · CRITIC_ · LOGISTICS_ · FINANCE_
# 모든 LLM_* 키에 접두사를 붙일 수 있다 (ENABLED / PROVIDER / MODEL / BASE_URL / TIMEOUT_SECONDS / MAX_RETRIES)
#
# ★ 물류 Gemini 전환 (물류 LLM 정책 결정서 §6) — 물류만 바꾼다. 전역 LLM_PROVIDER 를
#   gemini 로 바꾸면 다른 Agent 까지 끌려가므로 금지.
#   - 모델은 stable 을 pin 한다 (latest/preview 별칭 금지).
#   - 물류 timeout 기본은 10초다 (원격 API — 재시도 포함 최악 약 20초에서 끊는다).
#   - API Key 는 Auth Key 로 신규 발급 (2026-09 부터 Standard 키 전면 거부).
#     Key 는 .env 로만 관리 — 코드·로그·Git 에 절대 넣지 않는다.
# LOGISTICS_LLM_PROVIDER=gemini
# LOGISTICS_LLM_MODEL=gemini-3.5-flash-lite
# LOGISTICS_LLM_TIMEOUT_SECONDS=10
# LOGISTICS_GEMINI_API_KEY=
#
# ★ Critic judge 는 생성 측(오케 selector)과 다른 모델을 권장한다 — 같은 모델이면
#   자기가 만든 설명을 자기가 승인한다 (Critic 설계서 §6.4).
# ORCHESTRATOR_LLM_MODEL=qwen2.5:7b
# CRITIC_LLM_MODEL=exaone3.5:7.8b
# CRITIC_LLM_TIMEOUT_SECONDS=60
