DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SCHEMA=
# 공통 LLM 설정 (에이전트별 override 가 없으면 이 값을 쓴다)
LLM_ENABLED=true
LLM_PROVIDER=ollama
LLM_MODEL=gemma3:4b
LLM_BASE_URL=http://127.0.0.1:11434
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
ORCHESTRATOR_LLM_MODEL=qwen2.5:7b   # 오케 selector 만
CRITIC_LLM_MODEL=exaone3.5:7.8b     # Critic judge 만


# 에이전트별 override (선택) — 두면 위 공통값을 덮는다.
# 지원: ORCHESTRATOR_ · CRITIC_  (finance/logistics 는 현재 공통값만 사용)
# 모든 LLM_* 키에 접두사를 붙일 수 있다 (ENABLED / PROVIDER / MODEL / BASE_URL / TIMEOUT_SECONDS / MAX_RETRIES)
#
# ★ Critic judge 는 생성 측(오케 selector)과 다른 모델을 권장한다 — 같은 모델이면
#   자기가 만든 설명을 자기가 승인한다 (Critic 설계서 §6.4).
# ORCHESTRATOR_LLM_MODEL=qwen2.5:7b
# CRITIC_LLM_MODEL=exaone3.5:7.8b
# CRITIC_LLM_TIMEOUT_SECONDS=60
